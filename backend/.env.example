# Copy this file to .env (for the app) and .env.test (for the tests), then fill in the values.
# .env and .env.test are never committed to git.

# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler".
# .env uses your main project; .env.test MUST use your separate test project.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Signs login tokens. Generate your own (never reuse this example):
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-value-at-least-32-characters

# Where the frontend runs. Login cookies and the CSRF check depend on it.
FRONTEND_URL=http://localhost:5173

# Voyage AI turns document text into embeddings for search. Create a key at https://dashboard.voyageai.com/
# (.env.test can leave this out: the tests never call Voyage.)
VOYAGE_API_KEY=replace-me

# Optional. These are the defaults:
# EMBEDDING_MODEL=voyage-4
# MAX_UPLOAD_MB=20
# MAX_PDF_PAGES=500
# MAX_DOCUMENTS_PER_USER=50

# Claude writes the answers. Create a key at https://platform.claude.com/
# (.env.test can leave this out: the tests never call Claude.)
ANTHROPIC_API_KEY=replace-me

# Optional. The default:
# MAX_QUESTIONS_PER_DAY=100
